{
    "editor.rulers": [
        // Show a vertical line at column 80 to indicate the line length limit.
        80
    ],
    "editor.formatOnSave": true,
    // Native VS Code functionality, does not require black formatter.
    "files.trimTrailingWhitespace": true,
    // Requires source control
    "editor.formatOnSaveMode": "modifications",
    // Black formatter does not work in Cursor, see:
