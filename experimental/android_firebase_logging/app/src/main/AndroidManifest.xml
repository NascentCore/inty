<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 网络权限 - Firebase 需要 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    
    <!-- 可选：用于获取设备信息进行更好的崩溃分析 -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.FirebaseLoggingSample"
        tools:targetApi="31">
        
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.FirebaseLoggingSample">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        
        <!-- Firebase Analytics 服务 -->
        <service
            android:name="com.google.firebase.analytics.FirebaseAnalyticsService"
            android:exported="false" />
            
        <!-- Firebase Crashlytics 服务 -->
        <service
            android:name="com.google.firebase.crashlytics.FirebaseCrashlyticsService"
            android:exported="false" />
            
        <!-- Firebase Performance Monitoring -->
        <service
            android:name="com.google.firebase.perf.FirebasePerformanceService"
            android:exported="false" />
            
    </application>

</manifest>