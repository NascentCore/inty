<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.Inty" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowDisablePreview">true</item>
    </style>

    <!-- 启动主题-->
    <style name="Theme.Inty.Launcher" parent="android:Theme.Material.Light.NoActionBar">
        <!-- 这个属性配置，必须是引用形式，直接写#ff0000 颜色格式，不生效-->
        <item name="android:windowBackground">@color/app_background</item>
    </style>

    <!-- Dark theme for popup activities -->
    <style name="Theme.Inty.Popup" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">#1C1523</item>
        <item name="android:windowDisablePreview">true</item>
        <item name="android:statusBarColor">#1C1523</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowTranslucentStatus">false</item>
    </style>

    <!-- Login theme with translucent effect and proper status bar -->
    <style name="Theme.Inty.Login" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowDisablePreview">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowTranslucentStatus">true</item>
    </style>

    <!-- 图片裁剪界面的主题配置 不侵入状态栏 UCrop theme with proper status bar handling -->
    <style name="Theme.Inty.UCrop" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">#1C1523</item>
        <item name="android:statusBarColor">#1C1523</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowTranslucentStatus">false</item>
        <item name="android:fitsSystemWindows">true</item>
    </style>
</resources>
