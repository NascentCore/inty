# Overrides values defined in app/core/config.py
# All values are intended to be used in development environment.

app:
  debug: true
  backend_cors_origins: ["http://localhost:3000"]
  environment: "unspecified"
  limits:
    # Configurable counting cycle in hours for all time-based limits
    # When None or not set, defaults to 24 hours for backward compatibility
    # Example: limit_counting_cycle_hours: 12  # Use 12-hour rolling windows
    # Example: limit_counting_cycle_hours: 48  # Use 48-hour rolling windows
    # limit_counting_cycle_hours: null  # Use default 24-hour rolling windows

logging:                                                                         
  level: "DEBUG"

database:
  host: "localhost"

google_oauth:
  client_id: "<your-google-client-id>"
  client_secret: "<your-google-client-secret>"
  redirect_uri: "http://localhost:8000/api/v1/auth/google/callback"

agent:
  api_key: "<fill-in-your-openrouter-api-key>"
  langchain_api_key: "<fill-in-your-langchain_api_key>"

gcs:
  # 这是 it@sxwl.ai gcp 账户上配置的开发测试用存储桶，
  # 只要使用了来自 it@sxwl.ai 账户下的 service account，就能使用该存储桶
  bucket: "yx-test"
  credentials: ".secrets/gcs-service-account-key.json"

firebase:
  service_account_path: ".secrets/firebase-service-account.json"

google_play:
  service_account_key: ".secrets/google-play-service-account-key.json"
  webhook_secret: "<fill-in-your-webhook-secret>"

elevenlabs:
  api_key: "<your-elevenlabs-api-key>"
