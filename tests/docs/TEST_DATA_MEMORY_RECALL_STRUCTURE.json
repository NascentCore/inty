{
  "experiment": "memory_recall_memory_structure",
  "test_setup": {
    "comparison_target": "flat vs layered memory structure for recall accuracy",
    "fixed_model": "google/gemini-2.5-flash",
    "query_set_size": 8,
    "query_split": {
      "known_memory_cases": 6,
      "unknown_memory_cases": 2
    },
    "design_notes": [
      "flat memory intentionally mixes old and new values in one blob",
      "layered memory keeps canonical values in core/profile blocks",
      "unknown cases must return Z (UNKNOWN)"
    ]
  },
  "expected_outcome": {
    "primary_expectation": "Layered memory should improve known-memory recall accuracy and keep unknown-case hallucination low.",
    "acceptance_criteria": {
      "known_case_accuracy_layered_gte_flat": true,
      "overall_accuracy_layered_gte_flat": true,
      "unknown_hallucination_layered_lte_flat": true
    },
    "regression_alert_conditions": [
      "layered.known_case_accuracy + 0.10 < flat.known_case_accuracy",
      "layered.overall_accuracy + 0.10 < flat.overall_accuracy",
      "layered.unknown_hallucination_rate > flat.unknown_hallucination_rate"
    ]
  },
  "script": "experimental/memory_prompt_benchmark/memory_recall_benchmark.py",
  "config_file": "devops/config.yaml.dev",
  "runs": [
    {
      "run_id": "20260326_121058",
      "samples_per_case": 2,
      "temperature": 0.4,
      "summary": {
        "flat": {
          "overall_accuracy": 1.0,
          "known_case_accuracy": 1.0,
          "unknown_case_accuracy": 1.0,
          "unknown_hallucination_rate": 0.0
        },
        "layered": {
          "overall_accuracy": 1.0,
          "known_case_accuracy": 1.0,
          "unknown_case_accuracy": 1.0,
          "unknown_hallucination_rate": 0.0
        }
      },
      "source_report": "experimental/memory_prompt_benchmark/results/memory_recall_20260326_121058/report.md"
    },
    {
      "run_id": "20260326_121139",
      "samples_per_case": 6,
      "temperature": 0.7,
      "summary": {
        "flat": {
          "overall_accuracy": 1.0,
          "known_case_accuracy": 1.0,
          "unknown_case_accuracy": 1.0,
          "unknown_hallucination_rate": 0.0
        },
        "layered": {
          "overall_accuracy": 1.0,
          "known_case_accuracy": 1.0,
          "unknown_case_accuracy": 1.0,
          "unknown_hallucination_rate": 0.0
        }
      },
      "source_report": "experimental/memory_prompt_benchmark/results/memory_recall_20260326_121139/report.md"
    },
    {
      "run_id": "20260326_121318",
      "samples_per_case": 8,
