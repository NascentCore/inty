{
  "experiment": "tool_trigger_memory_structure",
  "test_setup": {
    "comparison_target": "flat vs layered memory structure for tool trigger behavior",
    "fixed_model": "google/gemini-2.5-flash",
    "query_set_size": 8,
    "query_split": {
      "tool_needed_cases": 4,
      "tool_not_needed_cases": 4
    },
    "tools": [
      "get_weather",
      "create_calendar_event",
      "web_search",
      "create_support_ticket"
    ]
  },
  "expected_outcome": {
    "primary_expectation": "Layered memory should reduce false tool triggers while preserving or improving tool-needed trigger rate.",
    "acceptance_criteria": {
      "trigger_rate_when_needed_layered_gte_flat": true,
      "trigger_rate_when_not_needed_layered_lte_flat": true,
      "expected_tool_match_rate_when_needed_layered_gte_flat": true
    },
    "regression_alert_conditions": [
      "layered.trigger_rate_when_not_needed > flat.trigger_rate_when_not_needed",
      "layered.trigger_rate_when_needed + 0.05 < flat.trigger_rate_when_needed",
      "layered.expected_tool_match_rate_when_needed + 0.05 < flat.expected_tool_match_rate_when_needed"
    ]
  },
  "model": "google/gemini-2.5-flash",
  "script": "experimental/memory_prompt_benchmark/tool_trigger_benchmark.py",
  "config_file": "devops/config.yaml.dev",
  "runs": [
    {
      "run_id": "20260326_100604",
      "samples_per_case": 2,
      "temperature": 0.7,
      "summary": {
        "flat": {
          "total_samples": 16,
          "trigger_rate_when_needed": 1.0,
          "trigger_rate_when_not_needed": 0.0,
          "expected_tool_match_rate_when_needed": 1.0
        },
        "layered": {
          "total_samples": 16,
          "trigger_rate_when_needed": 1.0,
          "trigger_rate_when_not_needed": 0.125,
          "expected_tool_match_rate_when_needed": 1.0
        }
      },
      "source_report": "experimental/memory_prompt_benchmark/results/tool_trigger_20260326_100604/report.md"
    },
    {
      "run_id": "20260326_100917",
      "samples_per_case": 4,
      "temperature": 0.7,
      "summary": {
        "flat": {
          "total_samples": 32,
          "trigger_rate_when_needed": 0.9375,
          "trigger_rate_when_not_needed": 0.0625,
          "expected_tool_match_rate_when_needed": 0.9375
        },
        "layered": {
          "total_samples": 32,
          "trigger_rate_when_needed": 0.9375,
          "trigger_rate_when_not_needed": 0.0,
          "expected_tool_match_rate_when_needed": 0.9375
        }
      },
      "source_report": "experimental/memory_prompt_benchmark/results/tool_trigger_20260326_100917/report.md"
    },
    {
      "run_id": "20260326_101048",
      "samples_per_case": 4,
      "temperature": 0.4,
      "summary": {
        "flat": {
          "total_samples": 32,
          "trigger_rate_when_needed": 0.875,
          "trigger_rate_when_not_needed": 0.25,
          "expected_tool_match_rate_when_needed": 0.875
        },
        "layered": {
          "total_samples": 32,
          "trigger_rate_when_needed": 0.9375,
          "trigger_rate_when_not_needed": 0.0,
          "expected_tool_match_rate_when_needed": 0.9375
        }
      },
      "per_case_trigger_rate": {
        "c01_weather": {
          "should_trigger_tool": true,
          "flat": 1.0,
          "layered": 1.0
        },
        "c02_calendar": {
          "should_trigger_tool": true,
          "flat": 0.5,
          "layered": 0.75
        },
        "c03_search": {
          "should_trigger_tool": true,
          "flat": 1.0,
          "layered": 1.0
        },
        "c04_support": {
          "should_trigger_tool": true,
          "flat": 1.0,
          "layered": 1.0
        },
        "c05_chitchat": {
          "should_trigger_tool": false,
          "flat": 0.0,
          "layered": 0.0
        },
        "c06_general_knowledge": {
          "should_trigger_tool": false,
          "flat": 1.0,
          "layered": 0.0
        },
        "c07_creative": {
          "should_trigger_tool": false,
          "flat": 0.0,
          "layered": 0.0
        },
        "c08_joke": {
          "should_trigger_tool": false,
          "flat": 0.0,
          "layered": 0.0
        }
      },
      "source_report": "experimental/memory_prompt_benchmark/results/tool_trigger_20260326_101048/report.md",
      "source_raw_data": "experimental/memory_prompt_benchmark/results/tool_trigger_20260326_101048/raw_data.json"
    }
  ]
}
