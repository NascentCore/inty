# Copy to tools/inty_v2_repl/.env (gitignored) for REPL WebSocket auth.
# INTY_ACCESS_TOKEN: same JWT as repo-root .inty_ops_bearer_token (backend/ops/start.sh --local).
# After a backend restart the file may change — update .env only when it no longer matches (see examine-local-inty-repl-env skill).
INTY_ACCESS_TOKEN=<paste from cat .inty_ops_bearer_token when first setting up or when differs>

# Optional: default agent UUID from Ops UI if you omit --agent-id
# TODO(cleanup): Consider force to specify on repl command line argument and remove this env var
# INTY_V2_CHAT_AGENT_ID=

# Optional: override HTTP root used for WS (default http://127.0.0.1:8000)
# TODO(cleanup): Consider force to specify on repl command line argument and remove this env var
# INTY_API_BASE_URL=http://127.0.0.1:8001

# Clickable langsmith_trace_url= in REPL metadata lines.
# Copy the same value as config.yaml agent.langchain_api_key (REPL does not load config.yaml).
# LANGCHAIN_API_KEY=<paste from config.yaml agent.langchain_api_key>

# Rare fallback if Client.get_run_url fails (UUIDs from LangSmith UI URL, not project name):
# LANGSMITH_WORKSPACE_ID=
# LANGSMITH_PROJECT_ID=
