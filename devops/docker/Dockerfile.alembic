# CREATED_BY_AGENT
FROM python:3.12-slim AS migrations

WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

# 安装 Alembic 升级所需的最小依赖
RUN pip install --no-cache-dir \
    "alembic==1.16.1" \
    "SQLAlchemy==2.0.41" \
    "psycopg[binary]==3.2.9" \
    "loguru==0.7.3" \
    "PyYAML==6.0.2" \
    "pydantic==2.11.5" \
    "Mako==1.3.10"

# 仅复制 Alembic 迁移及其依赖的最小 Python 模块
COPY alembic/ alembic/
COPY alembic.ini ./
COPY app/models app/models
COPY app/api/__init__.py app/api/__init__.py
COPY app/api/constants.py app/api/constants.py
COPY app/core/__init__.py app/core/__init__.py
COPY app/core/config.py app/core/config.py

ENV ALEMBIC_CONFIG=/app/alembic.ini

# 默认执行到最新版本；可通过 `docker run ... -x config=/app/config.yaml upgrade head` 覆盖
ENTRYPOINT ["alembic"]
CMD ["upgrade", "head"]

