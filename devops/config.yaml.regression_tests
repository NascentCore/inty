# REPL / companion harness regression E2E (run_inty_repl_regression.py).
# Calls real LLM, LangSmith, GitHub user-feedback, and other external services.
# Separate from devops/config.yaml.local so engineers can tune local REPL without
# breaking the automated regression gate. Database DSN matches config.yaml.local.
# Launch Ops for regression: export INTY_CONFIG_YAML=devops/config.yaml.regression_tests
# then ./backend/ops/start.sh --local --no-build-frontend (do not rely on --local default).
# Unit tests that mock external services use devops/config.yaml.test instead.
app:
  debug: true
  environment: local
  gcp_service_account_key: ".secrets/inty-backend-key.json"
  limits:
    free_user_chat_24h_limit: 1
    guest_user_chat_24h_limit: 1
    free_user_voice_24h_limit: 1
    guest_user_voice_24h_limit: 1
    subscribed_user_voice_24h_limit: 2
    # guest（游客）无法生图，必须登录，因此没有对应的设置
