# For running an actual backend server locally
# With all dependent services running locally or faked out
# Can be used to run end-to-end testing of the full app
app:
  debug: true
  environment: local
  limits:
    free_user_chat_24h_limit: 1
    guest_user_chat_24h_limit: 1
    free_user_voice_24h_limit: 1
    guest_user_voice_24h_limit: 1
    subscribed_user_voice_24h_limit: 2
    # guest（游客）无法生图，必须登录，因此没有对应的设置
    free_user_image_gen_24h_limit: 4
    subscribed_user_image_gen_24h_limit: 8
    free_user_agent_creation_24h_limit: 1
    subscribed_user_agent_creation_24h_limit: 2
  gcp_service_account_key: ".secrets/gcp-service-account-key.json"

sentry:
  # dev-inty/default
  dsn: "https://43877f17f1d13e7e2847d7fa994b5fd9@o4510350447411200.ingest.us.sentry.io/4510871322034176"
  enabled: true
  traces_sample_rate: 1.0  # 本地开发环境使用 100% 采样率以便调试

security:
  secret_key: "your-secret-key-here"
  algorithm: "HS256"
  access_token_expire_minutes: 10080

database:
  # Read-only replica: 34.87.163.31
  host: localhost
  port: 5432
  user: postgres
  # Read-only replica: sxwl666A!
  password: "sxwl666!"
  db: "inty"

google_oauth:
  client_id: "1034291688895-0e5hq72pghd4nihhpmf989ptv0ag1542.apps.googleusercontent.com"
  client_secret: "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"
  redirect_uri: "http://localhost:8000/api/v1/auth/google/callback"

gcs:
  bucket: "inty-static"

verification:
  code_expire_minutes: 5 

logging:
  level: "DEBUG"
  colorize: true

firebase:
  service_account_path: ".secrets/firebase-service-account-key.json"

agent:
  api_key: "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"
  # inty-dev api key personal access token
  langchain_api_key: "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"

google_play:
  package_name: "com.ai.intellimate"
  webhook_secret: ""
  enable_version_check: true
  min_supported_version: 10
  release_track: internal
  fallback_tracks: [internal]

elevenlabs:
  api_key: "sk_1976538731e00d58493ed27e63165adfa8d513c4c327c68c"
  model: "eleven_flash_v2_5"  # Flash v2.5 - 最快的实时模型，75ms延迟
  voice_id: "EXAVITQu4vr4xnSDxMaL"  # Sarah - 温柔女声
  output_format: "mp3_22050_32"  # 优化的移动端格式：更小文件，更快传输
  enabled: true
  max_text_length: 5000  # 最大文本长度限制

cloudflare:
  domain: "images.sxwl.dev"
  enabled: true
  fallback_to_original: true

gemini_live:
  enabled: true
  project_id: "alien-paratext-461204-i9"
  location: "us-central1"
  # Live Chat 用量限制（本地开发环境使用较小限制以便测试）
  free_user_agent_limit: 5  # 免费用户累计可聊天的 agent 数
  sub_user_agent_limit: 20  # 订阅用户累计可聊天的 agent 数
  free_user_max_session_duration: 60  # 免费用户单次会话最大时长（秒）
  sub_user_max_session_duration: 120  # 订阅用户单次会话最大时长（秒）
