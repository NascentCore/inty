# Config for the shared dev environment for the whole team.
# Share the same database as config.yaml.prod.
app:
  debug: true
  environment: dev
  limits:
    free_user_chat_24h_limit: 20
    guest_user_chat_24h_limit: 1
    free_user_voice_24h_limit: 500
    guest_user_voice_24h_limit: 1
    subscribed_user_voice_24h_limit: 10
    # guest（游客）无法生图，必须登录，因此没有对应的设置
    free_user_image_gen_24h_limit: 500
    subscribed_user_image_gen_24h_limit: 10
    free_user_agent_creation_24h_limit: 500
    subscribed_user_agent_creation_24h_limit: 10
  gcp_service_account_key: "inty-backend-key.json"
  min_app_version_code_for_festival_memory: 3345

sentry:
  # dev-inty/default
  dsn: "https://43877f17f1d13e7e2847d7fa994b5fd9@o4510350447411200.ingest.us.sentry.io/4510871322034176"
  enabled: true
  traces_sample_rate: 1.0  # 开发环境使用 100% 采样率以便调试

security:
  secret_key: "your-secret-key-here"
  algorithm: "HS256"
  access_token_expire_minutes: 10080

database:
  # Same Docker Postgres instance as config.yaml.prod (host/port/user/password); logical db is inty-dev.
  host: "host.docker.internal"
  port: 5432
  user: "postgres"
  password: "sxwl666A!"
  db: "inty-dev"
  pool_size: 20
  max_overflow: 10
  pool_timeout: 10
  pool_recycle: 3600
  pool_pre_ping: true
  connect_timeout: 5
  command_timeout: 30

google_oauth:
  client_id: "1034291688895-0e5hq72pghd4nihhpmf989ptv0ag1542.apps.googleusercontent.com"
  client_secret: "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"
  redirect_uri: "http://localhost:8000/api/v1/auth/google/callback"

gcs:
  bucket: "inty-static"

verification:
  code_expire_minutes: 5 

logging:
  level: "DEBUG"

firebase:
  service_account_path: "inty-firebase-key.json"

agent:
  # 测试用 API key，每周上限 $10，inty-dev API key，intellimate-dev project
  api_key: "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"
  # intellimate-dev project, inty-dev-shared api key, personal access token
  # 用于所有 dev 环境的 trace 记录
  langchain_api_key: "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"
  companion_harness:
    user_feedback_github:
      token: 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
  # 与 Prod 环境配置保持一致，方便测试
  # 消息生图模型配置：dev 环境免费用户使用 fal 模型（降低成本）
  free_user_chat_image_model: "Z Image Turbo Image to Image"
  # 订阅用户使用 pro 具有更好的边界把控能力，降低违禁风险
  sub_user_chat_image_model: "NewAPI Nano Banana 2"
  newapi_gemini_base_url: "https://llm.sxwl.ai"
  vertex_ai_location: "global"
  newapi_gemini_bearer_token: "sk-NgSZYRAbWEPRtfgSObaz242qA2VhpneytPop97LkmeP4aBy7"
  # 测试环境量小，就全部追踪
  langsmith_text_chat_sample_rate: 1.0
  # 打开生图兜底，使用只包含 iMate 形象的图片作为候选
  enable_chat_image_match_fallback: true
  # 设置为最理想的聊天模型
  free_user_chat_model: "deepseek/deepseek-v4-flash"
  sub_user_chat_model: "deepseek/deepseek-v4-flash"

  companion_tool_call_model: "google/gemini-3.5-flash"

  # 打开高级功能预览，吸引用户付费
  enable_free_user_premium_preview: true
  free_user_premium_preview_every_n_messages: 10
  free_user_premium_preview_max_chars: 200
  channels:
    telegram:
      # Yaxiong's personal telegram account's bot Fairy.
      bot_token: "8948082813:AAH0VqLbfi52thLv_V0EgjvDrVsYXVMigN4"

google_play:
  package_name: "com.ai.intellimate"
  webhook_secret: ""
  enable_version_check: true
  min_supported_version: 10
  release_track: internal
  fallback_tracks: [internal]
  # 当前生产环境版本代码（设置为正数时直接使用，不调用 Google Play API，避免配额消耗）
  # 设置为 0 时从 Google Play API 动态获取
  current_version_code: 14225

elevenlabs:
  api_key: "sk_1976538731e00d58493ed27e63165adfa8d513c4c327c68c"
  model: "eleven_flash_v2_5"  # Flash v2.5 - 最快的实时模型，75ms延迟
  voice_id: "EXAVITQu4vr4xnSDxMaL"  # Sarah - 温柔女声
  output_format: "mp3_22050_32"  # 优化的移动端格式：更小文件，更快传输
  enabled: true
  max_text_length: 5000  # 最大文本长度限制

cloudflare:
  domain: "images.sxwl.dev"
  enabled: true
  fallback_to_original: true

gemini_live:
  enabled: true
  project_id: "alien-paratext-461204-i9"
  location: "us-central1"
  model: "gemini-live-2.5-flash-preview-native-audio-09-2025"
  send_sample_rate: 16000
  receive_sample_rate: 24000
  default_voice: "Zephyr"
  session_resumption: true
  input_transcription: true
  output_transcription: true
  save_voice_history: true
  # Live Chat 用量限制（开发环境放宽限制）
  free_user_max_session_duration: 120  # 免费用户单次会话最大时长（秒）
  sub_user_max_session_duration: 300  # 订阅用户单次会话最大时长（秒）
  free_user_total_duration_24h: 120000

fal:
  # inty-dev API Key FAL.AI
  api_key: e5d909a2-5707-455a-bd91-1777531504b8:7e7cc84b6ebcb998a51cb830f77f2c13

tts:
  use_gemini_prompted_tts: true
  enable_gemini_tts_then_elevenlabs_voice_changer_for_imate: true

surprise_snap:
  enabled_since: "2026-02-24T08:00:00"
  trigger_rounds: [2,4,7,11]

memory_extraction:
  workflow_mode: "daily_incremental_summarization"
