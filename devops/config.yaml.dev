app:
  debug: true
  environment: dev
  limits:
    free_user_chat_24h_limit: 500
    guest_user_chat_24h_limit: 1
    free_user_voice_24h_limit: 500
    guest_user_voice_24h_limit: 1
    subscribed_user_voice_24h_limit: 10
    # guest（游客）无法生图，必须登录，因此没有对应的设置
    free_user_image_gen_24h_limit: 500
    subscribed_user_image_gen_24h_limit: 10
    free_user_agent_creation_24h_limit: 500
    subscribed_user_agent_creation_24h_limit: 10
  gcp_service_account_key: "inty-backend-key.json"

sentry:
  dsn: "https://35871471ace10dd7da9a7e26fe516fa4@o4510350447411200.ingest.us.sentry.io/4510350448459776"
  enabled: true
  traces_sample_rate: 1.0  # 开发环境使用 100% 采样率以便调试

security:
  secret_key: "your-secret-key-here"
  algorithm: "HS256"
  access_token_expire_minutes: 10080

database:
  host: "10.41.177.3"
  port: 5432
  user: postgres
  password: "sxwl666A!"
  db: "inty-dev"
  pool_size: 50
  max_overflow: 20
  pool_timeout: 10
  pool_recycle: 3600
  pool_pre_ping: true
  connect_timeout: 5
  command_timeout: 30

google_oauth:
  client_id: "1034291688895-0e5hq72pghd4nihhpmf989ptv0ag1542.apps.googleusercontent.com"
  client_secret: "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"
  redirect_uri: "http://localhost:8000/api/v1/auth/google/callback"

gcs:
  bucket: "inty-static"

verification:
  code_expire_minutes: 5 

logging:
  level: "DEBUG"
  format: "<green>{time:YYYY-MM-DD HH:mm:ss.SSS}</green> | <level>{level: <8}</level> | <cyan>{extra[request_id]}</cyan> | <cyan>{name}</cyan>:<cyan>{function}</cyan>:<cyan>{line}</cyan> - <level>{message}</level>"

firebase:
  service_account_path: "inty-firebase-key.json"

agent:
  api_key: "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"
  # inty-dev api key personal access token
  langchain_api_key: "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"
  # 消息生图模型配置：dev 环境免费用户使用 fal 模型（降低成本），订阅用户使用 gemini
  free_user_chat_image_model: "gemini"
  sub_user_chat_image_model: "gemini"

google_play:
  package_name: "com.ai.intellimate"
  webhook_secret: ""
  enable_version_check: true
  min_supported_version: 10
  popup_reminder_version_code_gap: 200
  settings_reminder_version_code_gap: 200
  release_track: internal
  fallback_tracks: [internal]
  # 当前生产环境版本代码（设置为正数时直接使用，不调用 Google Play API，避免配额消耗）
  # 设置为 0 时从 Google Play API 动态获取
  current_version_code: 2949

elevenlabs:
  api_key: "sk_1976538731e00d58493ed27e63165adfa8d513c4c327c68c"
  model: "eleven_flash_v2_5"  # Flash v2.5 - 最快的实时模型，75ms延迟
  voice_id: "EXAVITQu4vr4xnSDxMaL"  # Sarah - 温柔女声
  output_format: "mp3_22050_32"  # 优化的移动端格式：更小文件，更快传输
  enabled: true
  max_text_length: 5000  # 最大文本长度限制

cloudflare:
  domain: "images.sxwl.dev"
  enabled: true
  fallback_to_original: true

gemini_live:
  enabled: true
  project_id: "alien-paratext-461204-i9"
  location: "us-central1"
  model: "gemini-live-2.5-flash-preview-native-audio-09-2025"
  send_sample_rate: 16000
  receive_sample_rate: 24000
  default_voice: "Zephyr"
  session_resumption: true
  input_transcription: true
  output_transcription: true
  save_voice_history: true
  # Live Chat 用量限制（开发环境放宽限制）
  free_user_max_session_duration: 120  # 免费用户单次会话最大时长（秒）
  sub_user_max_session_duration: 300  # 订阅用户单次会话最大时长（秒）

fal:
  api_key: c5403f4b-1171-4b13-80ef-684802b2c3c9:26b324871f439642e5a375481e01cd25