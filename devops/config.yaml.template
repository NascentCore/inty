# Used to generate config.yaml for different deployment environments.
app:
  {{ app.backend_cors_origins }}

security:
  {{ security.secret_key }}
  algorithm: "HS256"
  access_token_expire_minutes: 10080

database:
  {{ database.host }}
  {{ database.password }}
  port: 5432
  user: postgres
  pool_size: 50
  max_overflow: 20
  pool_timeout: 10
  pool_recycle: 3600
  pool_pre_ping: true
  connect_timeout: 5
  command_timeout: 30

google_oauth:
  {{ google_oauth__client_id }}
  {{ google_oauth__client_secret }}
  redirect_uri: "http://localhost:8000/api/v1/auth/google/callback"

gcs:
  credentials: "inty-backend-key.json"
  {{ gcs__bucket }}

verification:
  code_expire_minutes: 5 

firebase:
  service_account_path: "inty-firebase-key.json"

agent:
  model: "google/gemini-2.5-flash"
  {{ agent__api_key }}
  base_url: "https://openrouter.ai/api/v1"
  enable_debug_logging: true

google_play:
  package_name: "com.ai.intellimate"
  webhook_secret: ""

elevenlabs:
  {{ elevenlabs__api_key }}
  model: "eleven_flash_v2_5"
  voice_id: "EXAVITQu4vr4xnSDxMaL"
  output_format: "mp3_22050_32"
  enabled: true
  max_text_length: 5000

push_notification:
  enabled: false  # 是否启用推送服务
  batch_size: 50  # 每批处理的聊天数量
  max_retries: 3  # 最大重试次数
  # 推送阶段策略配置（10min, 30min, 2h, 24h, 48h），有聊天记录和无聊天记录用户共用
  stages:
    10min:
      count: 0  # 未读推送记录数
      minutes: 10  # 时间阈值（分钟）
    30min:
      count: 1  # 未读推送记录数
      minutes: 30  # 时间阈值（分钟）
    2h:
      count: 2  # 未读推送记录数
      minutes: 120  # 时间阈值（分钟）
    24h:
      count: 3  # 未读推送记录数
      hours: 24  # 时间阈值（小时）
    48h:
      count: 4  # 未读推送记录数
      hours: 48  # 时间阈值（小时）
