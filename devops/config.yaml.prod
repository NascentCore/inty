app:
  environment: prod
  # 仅当请求头 appVersionCode >= 此值时返回记忆提醒；0 表示不按版本限制。不配则默认 0。
  # 4000 远远大于现在的 commit count，这样相当于禁止功能；这样方便测试后端：
  # https://github.com/NascentCore/inty/blob/130596ee989fce0bd4db863d1030274950cd4bf6/devops/config.yaml.dev#L16C45-L16C49
  # app 发布上线之前，这个数值要调整回 dev 环境的数值：3345
  min_app_version_code_for_festival_memory: 3585

  limits:
    guest_user_chat_24h_limit: 10
    free_user_chat_24h_limit: 100
    guest_user_voice_24h_limit: 1
    free_user_voice_24h_limit: 5
    subscribed_user_voice_24h_limit: 100
    free_user_image_gen_24h_limit: 5
    subscribed_user_image_gen_24h_limit: 10
    free_user_agent_creation_24h_limit: 1
    subscribed_user_agent_creation_24h_limit: 5
    free_user_chat_messages_limit: 100
  gcp_service_account_key: "inty-backend-key.json"

sentry:
  # inty-backend/default
  dsn: "https://35871471ace10dd7da9a7e26fe516fa4@o4510350447411200.ingest.us.sentry.io/4510350448459776"
  # Sentry 生成大量日志，影响排查，目前也没有实际帮助到 devops（由于无法有效获得 trace）
  enabled: false
  traces_sample_rate: 0.1

security:
  secret_key: "893-ac77-4b6d-b644"
  algorithm: "HS256"
  access_token_expire_minutes: 10080

database:
  host: host.docker.internal
  port: 5432
  user: "postgres"
  password: "sxwl666A!"
  db: "inty"
  pool_size: 50
  max_overflow: 20
  pool_timeout: 10
  pool_recycle: 3600
  pool_pre_ping: true
  connect_timeout: 5
  command_timeout: 30

google_oauth:
  client_id: "1034291688895-0e5hq72pghd4nihhpmf989ptv0ag1542.apps.googleusercontent.com"
  client_secret: "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"
  redirect_uri: "http://localhost:8000/api/v1/auth/google/callback"

gcs:
  bucket: "inty-static"

verification:
  code_expire_minutes: 5 

firebase:
  service_account_path: "inty-firebase-key.json"

agent:
  # OpenRouter API Key: inty-prod
  api_key: "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"
  base_url: "https://openrouter.ai/api/v1"
  # LangSmith try@sxwl.ai IntelliMate-prod project, inty-prod API key 名字
  langchain_api_key: "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"
  force_default_prompts: false
  # DeepSeek v3.2 延时过高
  # free_user_chat_model: "DeepSeek V3.2"
  # 消息生图模型配置：prod 环境免费用户使用 fal 模型（降低成本），订阅用户使用 gemini
  # free_user_chat_image_model: "Nano Banana" # 效果更好，但是相对鸡肋：审核严导致成功率低、速度比 z-image 慢很多
  free_user_chat_image_model: "Z Image Turbo Image to Image" # 示例效果：https://github.com/user-attachments/assets/8fb4df85-4469-4bb1-aefc-68f43eb7bc34
  newapi_gemini_base_url: "https://llm.sxwl.ai"
  newapi_gemini_bearer_token: "sk-NgSZYRAbWEPRtfgSObaz242qA2VhpneytPop97LkmeP4aBy7"
  sub_user_chat_image_model: "NewAPI Nano Banana 2"
  # 使用 global 可改善 gemini-3-pro-image-preview 的可用性
  vertex_ai_location: "global"

  # 打开生图兜底，使用只包含 iMate 形象的图片作为候选
  enable_chat_image_match_fallback: true
  # 生产环境进一步缩小追踪数量，避免月度 LangSmith trace 配额耗尽。
  langsmith_text_chat_sample_rate: 0.01
  # 邮件列表中对应的用户的文字聊天始终 trace（仅保留运维排障账户）。
  langsmith_text_chat_always_trace_user_emails:
    - "anonymoussocialforreal@gmail.com"
    - "charlesfengyu@gmail.com"
    - "it@sxwl.ai"
    - "justicezyx@gmail.com"  # 赵亚雄个人账户

  companion_harness:
    user_feedback_github:
      token: "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"

  channels:
    telegram:
      # Name: Inty (the AI personal companion)
      bot_token: "8698820835:AAHnkct0luG_MZJpaI_rwWKx15fe5GeHeJU"

google_play:
  package_name: "com.ai.intellimate"
  webhook_secret: ""
  enable_version_check: true
  min_supported_version: 100
  # 设置为 0 时从 Google Play API 动态获取
  current_version_code: 14225

elevenlabs:
  api_key: "sk_1976538731e00d58493ed27e63165adfa8d513c4c327c68c"
  model: "eleven_flash_v2_5"  # Flash v2.5 - 最快的实时模型，75ms延迟
  voice_id: "EXAVITQu4vr4xnSDxMaL"  # Sarah - 温柔女声
  output_format: "mp3_22050_32"  # 优化的移动端格式：更小文件，更快传输
  enabled: true
  max_text_length: 5000  # 最大文本长度限制

cloudflare:
  domain: "images.sxwl.dev"
  enabled: true
  fallback_to_original: true

logging:
  level: "INFO"

gemini_live:
  enabled: true
  project_id: "alien-paratext-461204-i9"
  location: "us-central1"
  model: "gemini-live-2.5-flash-preview-native-audio-09-2025"
  send_sample_rate: 16000
  receive_sample_rate: 24000
  default_voice: "Zephyr"
  session_resumption: true
  input_transcription: true
  output_transcription: true
  save_voice_history: true
  # Live Chat 用量限制
  free_user_max_session_duration: 60  # 免费用户单次会话最大时长（秒）
  sub_user_max_session_duration: 120  # 订阅用户单次会话最大时长（秒）
  
fal:
  # inty-prod API Key, fal.ai
  api_key: 0b135fdb-8e5c-46ee-971a-3694410d98d2:3881993c5f3268bf109fbbfd505f1991

memory_extraction:
  workflow_mode: "daily_incremental_summarization"
