# Overrides values defined in app/core/config.py
# All values are intended to be used in testing environment on CI.

app:
  debug: true
  backend_cors_origins: ["http://localhost:3000"]
  environment: "test"
  # 用于测试上限较高
  limits:
    free_user_chat_24h_limit: 100
    guest_user_chat_24h_limit: 100
    free_user_voice_24h_limit: 100
    guest_user_voice_24h_limit: 100
    subscribed_user_voice_24h_limit: 200
    # guest（游客）无法生图，必须登录，因此没有对应的设置
    free_user_image_gen_24h_limit: 400
    subscribed_user_image_gen_24h_limit: 80
    free_user_agent_creation_24h_limit: 10
    subscribed_user_agent_creation_24h_limit: 20

logging:                                                                         
  level: "DEBUG"

database:
  host: "localhost"

google_oauth:
  client_id: "<your-google-client-id>"
  client_secret: "<your-google-client-secret>"
  redirect_uri: "http://localhost:8000/api/v1/auth/google/callback"

agent:
  api_key: "<fill-in-your-openrouter-api-key>"
  langchain_api_key: "<fill-in-your-langchain_api_key>"

gcs:
  use_fake_gcs: true
  bucket: "inty-test"

firebase:
  service_account_path: ".secrets/firebase-service-account.json"

google_play:
  webhook_secret: "<fill-in-your-webhook-secret>"

elevenlabs:
  api_key: "<your-elevenlabs-api-key>"

cloudflare:
  enabled: true
  domain: "cdn.example.com"
