# Used for running backend server in tests.
# External services and tracing are disabled or faked so CI does not depend on third-party APIs.
# app.debug true: tolerate missing Firebase JSON in CI; OpenAPI on. Log level comes from logging.level / INTY_* only.

app:
  debug: true
  backend_cors_origins: ["http://localhost:3000"]
  environment: "test"
  # 这是一个非零值，用于测试该配置项等效果
  min_app_version_code_for_festival_memory: 1000
  features:
    # E2E / slow LLM: generous idle budget while client waits for companion LLM replies (default 60).
    chat_ws_idle_timeout_seconds: 180

sentry:
  # 测试当中关闭 sentry 数据采集，避免混杂测试数据与 dev/prod 环境、干扰正常阅读 sentry web ui 上的数据
  enabled: false

logging:
  level: "INFO"

database:
  host: "localhost"
  # Small pools: default PG max_connections=100; pytest shares DB with the uvicorn on :8000.
  pool_size: 16
  max_overflow: 4

google_oauth:
  client_id: "<your-google-client-id>"
  client_secret: "<your-google-client-secret>"
  redirect_uri: "http://localhost:8000/api/v1/auth/google/callback"

agent:
  # 测试用 API key，每周上限 $1，inty-testing API key，intellimate-dev project
  api_key: "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"
  # inty-testing API key
  langchain_api_key: "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"
  langsmith_tracing_enabled: false
  # 测试环境使用 Gemini 模型，避免调用真实 FAL API（需要 FAL_KEY）
  free_user_text_to_image_model: "imagen-3.0-generate-002"
  sub_user_text_to_image_model: "imagen-3.0-generate-002"
  free_user_chat_image_model: "Nano Banana"
  sub_user_chat_image_model: "Nano Banana Pro"
  # OpenRouter chat model for E2E (``z-ai/glm-4.5-air:free`` retired on provider).
  sub_user_chat_model: "deepseek/deepseek-v4-flash"
  free_user_chat_model: "deepseek/deepseek-v4-flash"
  # Agent 聊天轻量数据缓存 TTL（秒），默认 1200（20 分钟）
  agent_config_cache_ttl_seconds: 1200
  # 测试环境无需追踪
  langsmith_tracing_enabled: false

gcs:
  use_fake_gcs: true
  bucket: "inty-test"

firebase:
  service_account_path: ".secrets/firebase-service-account.json"

google_play:
  webhook_secret: "<fill-in-your-webhook-secret>"

elevenlabs:
  api_key: "<your-elevenlabs-api-key>"

tts:
  use_fake_tts: true

cloudflare:
  enabled: true
  domain: "cdn.example.com"

gemini_live:
  enabled: false
  # Live Chat 用量限制（测试环境）
  free_user_agent_limit: 5
  sub_user_agent_limit: 20
  free_user_max_session_duration: 60
  sub_user_max_session_duration: 120

phone_call:
  enabled: true
  default_country_code: "+1"
  twilio_from_number: ""
  twilio_media_stream_base_url: ""
  twilio_account_sid: ""
  twilio_auth_token: ""
  inbound_number_agent_map: {}
  default_inbound_agent_id: ""
  media_stream_token_ttl_seconds: 300

# Surprise Snap E2E：第 1 条用户消息即触发
surprise_snap:
  enabled_since: "2020-01-01T00:00:00"
  trigger_rounds: [1]
