{
  "name": "inty-evaluation-frontend",
  "version": "1.0.0",
  "description": "InTy 智能体评测系统前端",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "start": "npm run build-sdk && vite --mode production",
    "build-sdk": "cd inty_sdk && ./scripts/bootstrap --silent && (test -f ./node_modules/.bin/tsc-multi || (echo 'tsc-multi binary missing, reinstalling...' && yarn add tsc-multi@https://github.com/stainless-api/tsc-multi/releases/download/v1.1.9/tsc-multi.tgz --force)) && yarn build",
    "type-check": "tsc --noEmit",
    "lint:check": "eslint . --ext .ts,.tsx",
    "lint:format": "npx prettier --write \"**/*.{ts,tsx}\"",
    "lint": "npm run lint:check && npm run lint:format"
  },
  "dependencies": {
    "@ant-design/icons": "^5.2.6",
    "antd": "^5.12.0",
    "inty": "file:./inty_sdk",
    "prettier": "^3.6.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@typescript-eslint/eslint-plugin": "^6.7.0",
    "@typescript-eslint/parser": "^6.7.0",
    "@vitejs/plugin-react": "^4.1.0",
    "eslint": "^8.50.0",
    "eslint-plugin-react": "^7.33.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "typescript": "^5.2.0",
    "vite": "^5.0.0"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
