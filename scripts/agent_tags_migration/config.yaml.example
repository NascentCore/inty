# Agent Tags Migration 配置文件示例
# 复制此文件为 config.yaml 并修改相应配置

# 环境类型
environment: development # development, production, test

# 数据库配置
database:
  host: localhost
  port: 5432
  user: postgres
  password: postgres
  db: devdb
  pool_size: 10
  max_overflow: 20
  pool_timeout: 10
  pool_recycle: 3600
  pool_pre_ping: true
  connect_timeout: 5
  command_timeout: 30

# 迁移配置（可选，脚本会使用默认值）
migration:
  batch_size: 100              # 批处理大小
  skip_existing_tags: true     # 跳过已有标签的智能体
  normalize_tags: true         # 标准化标签
  min_tag_length: 2           # 最小标签长度
  max_tag_length: 50          # 最大标签长度
  backup_before_update: true   # 更新前备份数据

# 日志配置
logging:
  level: INFO                  # DEBUG, INFO, WARNING, ERROR
  file: "migration.log"        # 日志文件路径（可选）